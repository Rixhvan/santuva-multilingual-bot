{
  "intents": [
    {
      "name": "GREETING",
      "dialogue_act": "GREETING",
      "description": "User greets the system or opens dialogue",
      "examples": {
        "sa": ["नमस्ते", "नमो नमः", "सुप्रभातम्", "शुभदिनम्", "प्रणामः"],
        "en": ["hello", "hi", "hey there", "good morning", "good day"],
        "tcy": ["ನಮಸ್ಕಾರ", "namaskara", "solmelu", "ಸೊಲ್ಮೆಲು", "encha uller"]
      }
    },
    {
      "name": "FAREWELL",
      "dialogue_act": "FAREWELL",
      "description": "User departs or bids goodbye",
      "examples": {
        "sa": ["पुनर्मिलामः", "गमिष्यामि", "शुभं भवतु"],
        "en": ["bye", "goodbye", "see you later", "take care", "have a nice day"],
        "tcy": ["ಪೋದು ಬರ್ಪೆ", "podu barpe", "barpe", "ಬರ್ಪೆ"]
      }
    },
    {
      "name": "THANKS",
      "dialogue_act": "CONFIRMATION",
      "description": "User expresses gratitude",
      "examples": {
        "sa": ["धन्यवादः", "अनुगृहीतोऽस्मि", "कृतज्ञोऽस्मि"],
        "en": ["thank you", "thanks a lot", "many thanks", "appreciate it"],
        "tcy": ["ಸೊಲ್ಮೆಲು", "solmelu", "dhanyavada", "ಧನ್ಯವಾದ"]
      }
    },
    {
      "name": "INTRODUCTION",
      "dialogue_act": "STATEMENT",
      "description": "User introduces themselves or states their name",
      "examples": {
        "sa": ["मम नाम रामः", "मम नाम रमेशः", "अहं कृष्णः अस्मि"],
        "en": ["my name is Ramesh", "I am John", "myself Priya"],
        "tcy": ["ಎನ್ನ ಪುದರ್ ರಮೇಶ್", "enna pudar Ramesh", "yan Ramesh"]
      }
    },
    {
      "name": "HELP",
      "dialogue_act": "DIRECTIVE",
      "description": "User asks for help or assistance",
      "examples": {
        "sa": ["कृपया साहाय्यं करोतु", "अहं साहाय्यम् इच्छामि", "मां साहाय्यं कुरु"],
        "en": ["can you help me?", "I need assistance", "help please", "what can you do?"],
        "tcy": ["ಎಂಕ್ ಸಹಾಯ ಬೋಡು", "enk sahaya bodu", "dayamalth help malpule"]
      }
    },
    {
      "name": "LOCATION_QUERY",
      "dialogue_act": "QUESTION",
      "description": "User inquires where someone or somewhere is located",
      "examples": {
        "sa": ["चिकित्सकः कुत्र अस्ति?", "चिकित्सालयः कुत्र अस्ति?", "मार्गः कुत्र अस्ति?"],
        "en": ["where is the doctor?", "where is the hospital?", "can you tell me where to go?", "which floor is it on?"],
        "tcy": ["ದೋಕ್ತೆರ್ ವಾಡೆ ಉಲ್ಲೆರ್?", "vaade hospital undu?", "dokther vaade uller?", "hospital vaade ullundu?"]
      }
    },
    {
      "name": "TIME_QUERY",
      "dialogue_act": "QUESTION",
      "description": "User inquires about timing, hours, or schedule",
      "examples": {
        "sa": ["कदा चिकित्सकः आगमिष्यति?", "कः समयः अस्ति?", "चिकित्सालयस्य समयः कति?"],
        "en": ["when does the doctor come?", "what time is it open?", "what is the appointment time?"],
        "tcy": ["ಏಪ ದೋಕ್ತೆರ್ ಬರ್ಪೆರ್?", "portu aeti?", "timing daane?", "naale appointment eapa?"]
      }
    },
    {
      "name": "INFORMATION_QUERY",
      "dialogue_act": "QUESTION",
      "description": "User seeks information about a concept, person, or report",
      "examples": {
        "sa": ["मम चिकित्सकस्य विषये ज्ञातुम् इच्छामि", "संस्कृतभाषायाः विषये वदतु", "औषधस्य विषये वदतु"],
        "en": ["tell me about Sanskrit", "can I talk to someone about my report?", "I want information about the doctor"],
        "tcy": ["ವರದಿ ಬಗ್ಗೆ ಮಾಹಿತಿ ಬೋಡು", "tulu bage panle", "doctor bage gottunda?", "doctor naale appointment idiya?"]
      }
    },
    {
      "name": "REQUEST",
      "dialogue_act": "DIRECTIVE",
      "description": "User makes a general request or asks to perform an action",
