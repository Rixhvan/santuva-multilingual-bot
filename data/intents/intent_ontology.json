        "en": ["please do this", "can you check this for me?", "could you explain this?"],
        "tcy": ["dayamalth unden toole", "undenu malpule", "dayamalth panle"]
      }
    },
    {
      "name": "CONFIRMATION",
      "dialogue_act": "CONFIRMATION",
