# ==============================================================================
# Santuva Multilingual Conversational AI - Configuration Template (.env.example)
# ==============================================================================
# Sanskrit (संस्कृतम्) • English • Tulu (ತುಳು)
#
# Copy this file to '.env' to configure optional general-purpose LLM providers.
# If no API key is specified, Santuva functions completely offline using its
# built-in NLP pipeline, syntactic analysis, and deterministic response engine.
# ==============================================================================

# Server configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# ------------------------------------------------------------------------------
# General-Purpose LLM Provider Configuration (Optional)
# Santuva supports Google Gemini, OpenAI, Groq, and local Ollama.
# ------------------------------------------------------------------------------

# Option 1: Google Gemini (Recommended for fast multilingual generation)
GEMINI_API_KEY=
# LLM_MODEL_NAME=gemini-1.5-flash

# Option 2: OpenAI
# OPENAI_API_KEY=
# LLM_MODEL_NAME=gpt-4o-mini

# Option 3: Groq
# GROQ_API_KEY=
# LLM_MODEL_NAME=llama-3.1-8b-instant

# Option 4: Local Ollama (Completely offline & local)
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL_NAME=llama3
